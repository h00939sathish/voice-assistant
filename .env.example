# Gemini API Key (required for online LLM fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Ultra Fast Inference)
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ElevenLabs API Key (High Quality TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# News API Key
NEWSAPI_API_KEY=your_newsapi_api_key_here

# Ollama settings
OLLAMA_MODELS=phi4-mini:latest,qwen3.5:4b-q4_K_M
OLLAMA_HOST=http://localhost:11434
# Keep local LLM in memory between requests (use 0s for aggressive unload)
OLLAMA_KEEP_ALIVE=5m
# Dynamic tool discovery via MCP router (model gets search_tools first)
DYNAMIC_TOOL_DISCOVERY_ENABLED=true
# Max tools returned by search_tools per query
DYNAMIC_TOOL_DISCOVERY_TOP_K=8

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
# Minimum confidence required before a spoken command is executed
MIN_COMMAND_CONFIDENCE=0.55

# Low-memory mode: keep only wake-word resident, lazy-load STT/LLM after wake
LOW_MEMORY_MODE=false
# Delay before unloading STT after returning to IDLE
LOW_MEMORY_UNLOAD_DELAY_SEC=2.0

# TTS Voice (edge-tts)
TTS_VOICE=en-US-AriaNeural
# Enable offline TTS fallback (Piper)
TTS_USE_OFFLINE=true
# Path to Piper .onnx model for offline mode
PIPER_VOICE_PATH=data\models\piper\alan\medium\en_GB-alan-medium.onnx

# Wake word sensitivity (0.0 - 1.0)
WAKE_WORD_THRESHOLD=0.5

# MCP Server Keys
UPSTASH_API_KEY=your_upstash_api_key_here

# Google Apps Script bridge
# APPS_SCRIPT_URL must be the deployed Web App /exec URL
APPS_SCRIPT_URL=https://script.google.com/macros/s/your_web_app_deployment_id/exec
# APPS_SCRIPT_SECRET must be your Script Property BUDDY_SECRET, not the /exec URL ID
APPS_SCRIPT_SECRET=your_buddy_secret_here
